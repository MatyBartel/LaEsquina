{
  "appId": "com.ferreteriamc.app",
  "productName": "Ferreteria MC - Sistema de gestion",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/ferreteria-app/browser/**/*",
    "electron/**/*",
    "!electron/**/*.ts",
    "!**/*.map"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "electron/assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "electron/assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
} 